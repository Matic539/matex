# Copiar a .env y completar. NUNCA commitear el archivo .env.

# Conexión PostgreSQL local (BD matex ya creada según GIM-01)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/matex"

# Servidor
PORT=3000
NODE_ENV=development

# Autenticación (generar un secreto largo y aleatorio, ej: openssl rand -hex 32)
JWT_SECRET=cambiar-por-secreto-aleatorio-largo
JWT_EXPIRES_IN=8h

# CORS (origen del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Seed de usuarios demo
SEED_DEMO_PASSWORD=Matex.2026-cambiar
